{
  // conductor-site - a field guide to agentic engineering.
  // Spec / planDoc: docs/SPEC.md. Tracker: TRACKER.md. Appendix B of the spec is the trap list.
  //
  // TRAPS THIS FILE ITSELF CARRIES:
  //  * `conductor plan set` round-trips this file through System.Text.Json and DROPS EVERY COMMENT,
  //    and the plan EDITOR re-serialises the whole file - silently changing progress.kind and gate
  //    timeouts. Keep this annotated copy safe and `git diff` structurally before any reload.
  //  * `agent.model` is dropped silently unless {model} appears in BOTH args and resumeArgs. It does.
  //    Verify with `conductor journey` - the Model column must never read (default).
  //  * NO `telegram` BLOCK ON PURPOSE. This repo is PUBLIC, and a telegram block in this fleet
  //    carries the owner's chat id. If push notification is wanted, add it in an untracked
  //    local copy - never here.
  //  * NO `templatesDir` ON PURPOSE. The built-in session/fix templates are used, so this run
  //    cannot hit the brace-landmine class: an unresolved {token} in a template file throws and
  //    parks the run. Everything site-specific rides in promptExtra and readOrder instead.
  //  * The `evidence` gate is scoped to S4+ because the script it runs is built during S3.
  //    S3.4 proves it goes red when stale; from S4 it is enforced on every session.
  "version": "1.0",
  "planVersion": 1,
  "name": "conductor-site - a field guide to agentic engineering",
  "repo": "C:/code/conductor-site",
  "satelliteRepos": [],
  "tracker": "TRACKER.md",
  "planDoc": "docs/SPEC.md",
  "branchPattern": "^(main|s\\d+/.+)$",
  "pauseOnBlocked": true,

  "agent": {
    "command": "claude",
    "args": [
      "-p", "{prompt}",
      "--output-format", "stream-json",
      "--verbose",
      "--dangerously-skip-permissions",
      "--model", "{model}",
      "--session-id", "{sessionId}"
    ],
    "resumeArgs": [
      "-p", "{prompt}",
      "--output-format", "stream-json",
      "--verbose",
      "--dangerously-skip-permissions",
      "--model", "{model}",
      "--resume", "{claudeSessionId}"
    ],
    "output": "stream-json",
    "model": "claude-opus-5[1m]"
  },

  "advisor": {
    "enabled": true,
    "command": "claude",
    "args": ["-p", "{prompt}", "--output-format", "json", "--model", "claude-haiku-4-5-20251001"],
    "output": "json",
    "timeoutMinutes": 6
  },

  "progress": { "kind": "markdown-table" },

  "stages": [
    { "id": "S1", "name": "The face" },
    { "id": "S2", "name": "The content model", "dependsOn": ["S1"] },
    { "id": "S3", "name": "The harvest", "dependsOn": ["S2"] },
    { "id": "S4", "name": "The concept spine", "dependsOn": ["S3"] },
    { "id": "S5", "name": "The articles", "dependsOn": ["S4"] },
    { "id": "S6", "name": "The reports", "dependsOn": ["S5"] },
    { "id": "S7", "name": "Ship", "dependsOn": ["S6"], "ownerGated": true }
  ],

  "gates": [
    {
      "name": "site-fast",
      "shell": "powershell",
      "command": "Set-Location C:\\code\\conductor-site; npm run check; if ($LASTEXITCODE -ne 0) { Write-Host 'FAIL: npm run check'; exit 1 }; npm run build; if ($LASTEXITCODE -ne 0) { Write-Host 'FAIL: npm run build'; exit 1 }; Write-Host 'check + build green'; exit 0",
      "optional": false,
      "tier": "fast",
      "parallel": false,
      "timeoutMinutes": 15
    },
    {
      "name": "generated",
      "shell": "powershell",
      "command": "Set-Location C:\\code\\conductor-site; npm run headers; npm run content; npm run editor; $dirty = git status --porcelain -- vercel.json src/content public/; if ($dirty) { Write-Host 'FAIL: generated files are stale. Regenerate and commit:'; $dirty | ForEach-Object { Write-Host $_ }; exit 1 }; Write-Host 'generated files clean'; exit 0",
      "optional": false,
      "tier": "full",
      "parallel": false,
      "timeoutMinutes": 20
    },
    {
      "name": "evidence",
      "shell": "powershell",
      "command": "Set-Location C:\\code\\conductor-site; node scripts/harvest.mjs --check; if ($LASTEXITCODE -ne 0) { Write-Host 'FAIL: corpus.json is stale or a cited evidence key is missing'; exit 1 }; Write-Host 'every published figure recomputes from the run store'; exit 0",
      "optional": false,
      "tier": "full",
      "parallel": false,
      "stages": ["S4", "S5", "S6", "S7"],
      "timeoutMinutes": 10
    }
  ],

  "gatePolicy": "stage",
  "verifyEachDelivery": false,

  "limits": {
    "stallMinutes": 15,
    "stallGraceMinutes": 3,
    "sessionTimeoutMinutes": 120,
    "batterySettleSeconds": 120,
    "authPreflight": true,
    "maxResumesPerSession": 2,
    "stageSlackFactor": 2,
    "backoffMinutes": 30,
    "maxBackoffs": 10,
    "maxRunCostUsd": 400,
    "approvalMode": false,
    "maxSessionTokens": 16000000,
    "softBreakRatio": 0.62,
    "maxConcurrentLanes": 1,
    "stallPatternTermination": true,
    "sameFailureCircuitBreaker": true,
    "stallBackoffMinutes": 12,
    "overheadCostPerSecond": 0.0001,
    "verifierThreshold": 80
  },

  "report": { "enabled": true },

  "readOrder": ["docs/SPEC.md", "TRACKER.md", "README.md"],

  "promptExtra": "THIS REPO IS PUBLIC FROM COMMIT ONE. Nothing private goes in - not in content, not in commit messages, not in evidence files, not in the tracker. No client names, no private repo names in report prose, no absolute paths from the owner's machine, no tokens or chat ids. Public repos that MAY be named: conductor, DevContext2, Shamshir, sitekit, site-template. Everything else is described by shape.\n\ndocs/SPEC.md is the authority. Read it before writing anything, and re-read the part that governs your stage. It is complete: Part I is the identity and the three litmus tests, Part II the face, Part III the content model, Part IV the ten concepts, Part V the four articles, Part VI the reports and the anonymisation rule, Appendix A the measured corpus, Appendix B the traps.\n\nEVIDENCE RULES, which this site is about and therefore must obey itself:\n1. No figure is ever typed into content. Content names an evidence KEY; the value comes from src/data/corpus.json, which the harvest recomputes from the run store. A page citing a key that is not in the corpus must fail the build.\n2. Checkpoint counts come from `conductor history --json --limit 0`, NOT from SQL. A naive CheckpointConfirmed count answers 65 where the engine answers 287 of 300. This was measured during planning. Do not re-derive it.\n3. Open every run.db read-only (mode=ro). This machine's store is shared with other repos and with a run that is paused, not finished. Never write to it, never run a conductor verb that mutates another repo's run.\n4. Anonymisation fails closed: a run absent from anonymise.json is excluded from the site, never published under its real name.\n\nCONDUCTOR CITATIONS: the engine source is at C:/code/conductor, checked out on branch feat/karvan. Read it for file:line citations. NEVER commit to it, never run tools/install.ps1, never kill a dotnet or conductor process - a second run may share this machine.\n\nTHE FACE: colour roles come from C:/code/conductor/face-go/internal/widgets/color.go, for BOTH schemes. Never from the Catppuccin website - the shipped latte is darkened in-hue because stock latte fails the contrast bar. Name the ROLE in every rule; a hardcoded hex is correct in one scheme and wrong in the other.\n\nASTRO TRAPS ALREADY PAID FOR IN THIS FLEET: the Fonts API hashes family names, so CSS must consume the cssVariable and never the raw name - a token naming the raw family silently renders the fallback forever. The editor stylesheet is COPIED into public/ by `npm run editor`, never imported, because an imported stylesheet changes every page's CSP. `checkAnnotations` fails the build on a data-sk-edit that stops resolving, and `checkPlaceholders` on a TODO or an example.com - both are working as intended, so fix the content rather than the gate.\n\nA stage is not done because the words are written. It is done when `npm run check` is 0 errors, `npm run build` is green, the annotations resolve, and - from S4 - the evidence gate recomputes every figure the stage published."
}
