---
/* The front page's findings: a number, what it means, and where it is argued.
   ---------------------------------------------------------------------------
   This is the component that decides whether the front page is a contents page
   or a piece of writing. The shape is deliberately the same three moves each
   time — figure, claim, destination — because six of them in a column is the
   whole argument of the site made scannable: here is a thing the record turned
   out to say, here is the number, here is where you can check it.

   The number is set large and in the mono face, because on this site mono means
   "recomputed from the store" and this is the loudest place that promise gets
   made. Its own label sits under it in the figure's own words rather than in
   any written here — same rule as the evidence strip, for the same reason.

   No `data-sk-edit` on the figure or the label: both are the corpus's, and an
   owner editing one in a form would not get a different number, they would get
   a build that fails. The claim is written and carries its annotation. */
import { corpusFigure } from "../lib/evidence.js";
import type { Tag } from "../lib/tags.js";

export interface Finding {
  figure: string;
  claim: string;
  href: string;
  /** The destination's own title, so the link text cannot drift from it. */
  title: string;
  /** "Article", "Concept", "Run report" — which kind of page it leads to. */
  kind: string;
}

interface Props {
  items: Finding[];
  /** `data-sk-edit` path prefix for the claims — `findings.items`. */
  path: string;
}

const { items, path } = Astro.props;

const resolved = items.map((item) => ({
  ...item,
  value: corpusFigure("pages/home.yaml findings", item.figure)
}));
---

<ol class="findings">
  {
    resolved.map((item, index) => (
      <li>
        <p class="figure">
          <span class="value">{item.value.display}</span>
          <span class="label">{item.value.label}</span>
        </p>

        <p class="claim" data-sk-edit={`${path}[${index}].claim`}>
          {item.claim}
        </p>

        <p class="where">
          <a href={item.href}>
            <span class="kind">{item.kind}</span>
            <span class="title">{item.title}</span>
          </a>
        </p>
      </li>
    ))
  }
</ol>

<style>
  /* Two columns on a wide viewport, because six findings in one column is a
     scroll rather than a page — and the eye compares the numbers down the
     column, which is the comparison worth making. One column below the same
     64rem the table of contents and the corpus table already use, so the site
     has one breakpoint rather than three nobody can explain.

     `align-items: start` so a short finding does not stretch to the height of
     the tall one beside it and hang a rule in mid-air. */
  .findings {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-xl);
    display: grid;
    gap: var(--space-xl) var(--space-l);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .findings {
      grid-template-columns: 1fr 1fr;
    }
  }

  .findings li {
    border-block-start: var(--rule);
    padding-block-start: var(--space-s);
  }

  .figure {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  /* The one place on the site a figure is set at heading size. It is the front
     page's argument, and the argument is the number. */
  .value {
    font-family: var(--mono);
    font-size: var(--text-h2);
    color: var(--text);
    line-height: 1.1;
  }

  .label {
    font-size: var(--text-small);
    color: var(--muted);
  }

  .claim {
    margin-block-start: var(--space-2xs);
    color: var(--text);
  }

  .where {
    margin-block-start: var(--space-xs);
  }

  .where a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
    text-decoration: none;
    font-size: var(--text-small);
  }

  .kind {
    font-family: var(--mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .title {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .where a:hover .title,
  .where a:focus-visible .title {
    text-decoration-thickness: 2px;
  }
</style>
