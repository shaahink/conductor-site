---
/* The quiet top bar: wordmark, the sections, the theme toggle.

   The section list was a literal here and is not one any more (S2.2). It is
   built from `src/content/sections/` — the same three entries that carry each
   index page's own copy — and a section whose collection is still empty is
   left out. A section that exists and a section that is linked can no longer
   disagree, because there is only one list. */
import { navSections } from "../lib/collections.js";

const sections = await navSections();

/* Every word the theme button can ever show. "Theme" is what the markup ships
   with, because before `theme.js` runs nothing knows which scheme is in force
   and a button that guesses is a button that lies for one frame; "Dark" and
   "Light" are what `paint()` writes.

   They are listed here so the button can be sized to the widest of them
   *before* any of them is chosen — see the grid in the style block. The list
   is the same one `src/scripts/theme.js` writes, and
   `test/theme-toggle.test.mjs` fails if the two ever disagree, because a label
   added there and not here brings the layout shift straight back. */
const LABELS = ["Theme", "Dark", "Light"];
const INITIAL = LABELS[0];

/* `aria-current="page"` on the section a reader is inside, including its
   children: /concepts/context-engineering/ is still Concepts. */
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="topbar">
  <a class="wordmark" href="/">field guide</a>

  <nav aria-label="Sections">
    <ul>
      {
        sections.map((section) => (
          <li>
            <a href={section.href} aria-current={isCurrent(section.href) ? "page" : undefined}>
              {section.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {/* Hidden until html.js — a toggle that cannot toggle is worse than no
      toggle, and a no-JS visitor still gets their system's scheme from the
      media query in tokens.css. The gating rule is global (styles.css)
      because Astro's scoped styles rewrite a selector that starts at <html>
      into one that can never match. */}
  {/* The live label sits in the same single grid cell as a hidden copy of
      every other word the button can show, so the box is already as wide as
      the widest one and swapping the text moves nothing. `visibility: hidden`
      keeps a sizer in the layout while taking it out of the paint and out of
      the accessibility tree; `aria-hidden` says so a second time, because a
      screen reader reading "Theme Dark Light" would be worse than the shift
      this fixes. */}
  <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch the theme">
    <span data-theme-label>{INITIAL}</span>
    {
      LABELS.filter((label) => label !== INITIAL).map((label) => (
        <span class="sizer" aria-hidden="true">
          {label}
        </span>
      ))
    }
  </button>
</header>

<style>
  .topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-s) var(--space-m);
    padding-block: var(--space-s);
    padding-inline: var(--space-m);
    border-block-end: var(--rule);
    background: var(--mantle);
  }

  .wordmark {
    font-weight: var(--weight-bold);
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    margin-inline-end: auto;
  }

  .wordmark:hover {
    color: var(--accent);
  }

  nav ul {
    display: flex;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  /* One accent, used where it means something: it marks the current thing,
     which is the same job it does in the Face's own sidebar. */
  nav a[aria-current="page"] {
    color: var(--accent);
    font-weight: var(--weight-medium);
  }

  /* A one-cell grid with every candidate label stacked in it. The track is
     sized to the widest word, so the button's box is settled at first paint
     and stays settled: `Theme` → `Dark` on load used to drag the whole nav
     12px, and `Dark` → `Light` another 3px on every flip. Not a JS fix — the
     script has already run by the time it could measure anything, and the
     first shift happens before it runs at all. */
  .theme-toggle {
    font: inherit;
    font-size: var(--text-small);
    color: var(--muted);
    background: none;
    border: var(--rule);
    padding-block: var(--space-3xs);
    padding-inline: var(--space-2xs);
    cursor: pointer;
    display: inline-grid;
    justify-items: center;
  }

  .theme-toggle > * {
    grid-area: 1 / 1;
  }

  .theme-toggle .sizer {
    visibility: hidden;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--overlay);
  }
</style>
